{
  "name": "interfaze",
  "version": "0.1.0",
  "private": true,
  "description": "Interfaze — standalone ACN chat host (interfaze.io)",
  "scripts": {
    "dev": "next dev --port 3010",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && next build",
    "start": "next start --port 3010",
    "lint": "echo 'no lint config yet'",
    "deploy:prod": "npm run typecheck && npx vercel --prod --yes"
  },
  "dependencies": {
    "@acnlabs/agent-chat": "file:./packages/agent-chat",
    "@auth0/auth0-react": "^2.15.0",
    "next": "^16.2.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3"
  }
}
