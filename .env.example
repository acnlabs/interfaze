# Interfaze standalone host
# Global: interfaze.io (Auth0). CN: interfaze.acnlabs.cn (WeChat JWT).

# ---- Region ----
# NEXT_PUBLIC_REGION=cn

# ---- Global Auth0 (omit for CN builds) ----
NEXT_PUBLIC_AUTH0_DOMAIN=dev-ypufda63738rkary.us.auth0.com
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.agentplanet.org
NEXT_PUBLIC_AUTH0_CLIENT_ID=

# ---- Chat Gateway ----
# Global: https://api.agentplanet.org
# CN: https://api.acnlabs.cn
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8000

# /embed CSP prefers Gateway GET /api/chat/embed/config (embed_hosts registry).
# Optional overlay if Gateway is unreachable:
# NEXT_PUBLIC_EMBED_ALLOWED_ORIGINS=https://studio.example

# Public origin (Auth0 redirect / shell deep links)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3010

# Optional brand
NEXT_PUBLIC_SITE_NAME=Interfaze

# ---- CN only ----
# NEXT_PUBLIC_BFF_URL=https://mp.acnlabs.cn
# NEXT_PUBLIC_AGENTPLANET_URL=https://agentplanet.acnlabs.cn
# NEXT_PUBLIC_CN_WEB_LOGIN_ENABLED=true
# NEXT_PUBLIC_CN_WEB_LOGIN_HINT=Web 登录即将开放

# ---- Global PayPal (subscribe) ----
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
